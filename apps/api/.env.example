# Server Config
PORT=3000
NODE_ENV=development

# Database (MongoDB Replica Set for transactions)
MONGODB_URI=mongodb://localhost:27017/rental_management?replicaSet=rs0

# Redis (BullMQ & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super-secret-jwt-key-for-rental-management-system-32chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-for-rental-management-system-32
JWT_REFRESH_EXPIRES_IN=7d

# Field-Level Encryption (CCCD) - 32 bytes hex or string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# S3 Compatible Storage (MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=rental-storage
S3_FORCE_PATH_STYLE=true

# FCM (Firebase Cloud Messaging)
FCM_PROJECT_ID=dummy-rental-project
FCM_CLIENT_EMAIL=dummy-service-account@dummy-rental-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----\n"
