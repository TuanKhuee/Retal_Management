{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@common/(.*)$": "<rootDir>/../src/common/$1",
    "^@infra/(.*)$": "<rootDir>/../src/infra/$1",
    "^@modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^@jobs/(.*)$": "<rootDir>/../src/jobs/$1"
  }
}
